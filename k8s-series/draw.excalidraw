    {
      "id": "7YBycmKouBA-nzIkU4_sa",
      "type": "text",
      "x": 3942.7685533495896,
      "y": -425.90015727406524,
      "width": 760.7845872435887,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 516054087,
      "version": 1919,
      "versionNonce": 419141513,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790918786611,
      "created": 1790891999640,
      "link": null,
      "locked": false,
      "text": "one of the pods crashed\n- kubelet reports failure to the API server\n- API server store the report in etcd \n- controller manger detect conflict between current \nstate and desired state \n- controller creates a replacement\n- scheduler assign the new pod to a node\n- kubelet assign the new pod \n",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "one of the pods crashed\n- kubelet reports failure to the API server\n- API server store the report in etcd \n- controller manger detect conflict between current \nstate and desired state \n- controller creates a replacement\n- scheduler assign the new pod to a node\n- kubelet assign the new pod \n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
