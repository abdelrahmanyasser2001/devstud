      "seed": 1346916871,
      "version": 314,
      "versionNonce": 101684647,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790919076877,
      "created": 1790918909266,
      "link": null,
      "locked": false,
      "text": "pods are isolated if we create a pod by itself and the node it runs fails the pod dies and never\nbrought back\nno self-healing\nno scaling\nno zero-downtime updates\nwe work with Deployment to manage ReplicaSets that automatically handle scaling, updates, and\nrecovery.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pods are isolated if we create a pod by itself and the node it runs fails the pod dies and never brought back\nno self-healing\nno scaling\nno zero-downtime updates\nwe work with Deployment to manage ReplicaSets that automatically handle scaling, updates, and recovery.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
