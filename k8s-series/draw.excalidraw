      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pT6_eZvul5yu4a_DGzSo4",
      "type": "text",
      "x": 4788.226072107354,
      "y": 2111.511495486372,
      "width": 1294.324776785716,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 520836432,
      "version": 265,
      "versionNonce": 1644023632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791000430283,
      "created": 1790997653057,
      "link": null,
      "locked": false,
      "text": "- The frontend is pointing at \"Backend Pods\", which are really three separate pods (A, B, C), each with its own IP\n- The question is: which IP does the frontend call?\n- The pod IPs are ephemeral. If a pod crashes, gets rescheduled, or is replaced during a deployment, it comes back with a new IP\n- So the frontend can't hardcode these addresses",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The frontend is pointing at \"Backend Pods\", which are really three separate pods (A, B, C), each with its own IP\n- The question is: which IP does the frontend call?\n- The pod IPs are ephemeral. If a pod crashes, gets rescheduled, or is replaced during a deployment, it comes back with a new IP\n- So the frontend can't hardcode these addresses",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
