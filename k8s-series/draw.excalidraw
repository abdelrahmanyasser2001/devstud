      "created": 1790908709991,
      "link": null,
      "locked": false,
      "text": "tools needed\n- kubectl to interact with API server \n- kind to create the cluster\n- docker to run cluster node",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "tools needed\n- kubectl to interact with API server \n- kind to create the cluster\n- docker to run cluster node",
