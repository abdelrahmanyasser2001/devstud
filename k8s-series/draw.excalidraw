    {
      "id": "PhqiG1Pg9PSmorAZY8ciA",
      "type": "text",
      "x": 3076.057381932751,
      "y": 266.4516156867163,
      "width": 1110.0868896545,
      "height": 770,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 338465703,
      "version": 695,
      "versionNonce": 240509287,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790910546821,
      "created": 1790908858974,
      "link": null,
      "locked": false,
      "text": "Basic kubectl commands\n\n#create a single node cluster containing the worker node and the control plane \n: kind create cluster\n\n# lists the names of all local Kubernetes clusters currently running via kind.\n: kind get clusters\n\n#verify connection between kubectl and kind cluster \n: kubectl cluster-info\n\n# list all the worker nodes and control-plane nodes\n: kubectl get nodes\n\n# list all the pods in your cluster\n: kubectl get pods -A\n\n#delete cluster\n: kind delete cluster\n\n#create configured multi node cluster (cluster.yaml)\n: kind create cluster --config cluster.yaml",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basic kubectl commands\n\n#create a single node cluster containing the worker node and the control plane \n: kind create cluster\n\n# lists the names of all local Kubernetes clusters currently running via kind.\n: kind get clusters\n\n#verify connection between kubectl and kind cluster \n: kubectl cluster-info\n\n# list all the worker nodes and control-plane nodes\n: kubectl get nodes\n\n# list all the pods in your cluster\n: kubectl get pods -A\n\n#delete cluster\n: kind delete cluster\n\n#create configured multi node cluster (cluster.yaml)\n: kind create cluster --config cluster.yaml",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
