    {
      "id": "tlJig18VG_TEex5yruK08",
      "type": "text",
      "x": 2316.7496233686516,
      "y": -568.6639382003461,
      "width": 1485.9914062592852,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 1409856551,
      "version": 1099,
      "versionNonce": 704978025,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "GuxJ-yfuoVqTd3MhZ7jmT",
          "type": "arrow"
        }
      ],
      "updated": 1790918650936,
      "created": 1790891460934,
      "link": null,
      "locked": false,
      "text": "Scenario\n\n- the use runs kubectl apply\n- kubectl sends the request to the API server\n- API server validate the request\n- the desired state is stored in etcd\n- controller manger detect a new pod must be created\n- scheduler choose worker nodes for the pods\n- kubelet on each selected node receives the pod specifications\n- container runtime [containerd] pulls the images and run the container\n- kublet reports to the API server the current status and its written in the etcd\n- kubrenetes controller manger continuously monitors the application    ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scenario\n\n- the use runs kubectl apply\n- kubectl sends the request to the API server\n- API server validate the request\n- the desired state is stored in etcd\n- controller manger detect a new pod must be created\n- scheduler choose worker nodes for the pods\n- kubelet on each selected node receives the pod specifications\n- container runtime [containerd] pulls the images and run the container\n- kublet reports to the API server the current status and its written in the etcd\n- kubrenetes controller manger continuously monitors the application    ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
