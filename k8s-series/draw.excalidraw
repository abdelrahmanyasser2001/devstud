    {
      "id": "sHAtHa7ukVlqtzD2_Wuvl",
      "type": "text",
      "x": 4855.552131068498,
      "y": -119.60070259647614,
      "width": 980.8035132035492,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
