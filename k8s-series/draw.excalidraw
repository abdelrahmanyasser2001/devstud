    {
      "id": "85p4n1rOJrLX9Ps_q_7Vj",
      "type": "text",
      "x": 2941.019747418639,
      "y": 1508.2165498320217,
      "width": 1400.4550917600275,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 1456769543,
      "version": 657,
      "versionNonce": 1588904361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790916148640,
      "created": 1790911623928,
      "link": null,
      "locked": false,
      "text": "#create a pod with ngniz image\nabdelrahman@debian:~/k8s-series$ kubectl run ngnix-pod --image=nginx\npod/ngnix-pod created\n\n#list all the pods in the cluster\nabdelrahman@debian:~/k8s-series$ kubectl get pods\nNAME        READY   STATUS              RESTARTS   AGE\nngnix-pod   1/1     ContainerCreating   0          14s\n\n# -o wide option to know on which worker node does the pod live \nabdelrahman@debian:~/k8s-series$ kubectl get pods -o wide\nNAME        READY   STATUS    RESTARTS   AGE     IP                       NODE                    NOMINATED NODE   READINESS GATES\nngnix-pod   1/1         Running          0          3m15s   10.244.1.2   multi-node-cluster-worker               <none>           <none>\n\n#print a detailed snapshot of your Pod's current configurations, status metrics, and lifecycle events.\nabdelrahman@debian:~/k8s-series$ kubectl describe pod ngnix-pod\n\n#delete pod\nabdelrahman@debian:~/k8s-series$ kubectl delete pod ngnix-pod\n\n#creating pod using configuration file (ngnix-pod.yaml)\nabdelrahman@debian:~/k8s-series$ kubectl apply -f ngnix-pod.yaml\n\n# --show-labels display(labels) attached to the pods\nabdelrahman@debian:~/k8s-series$ kubectl get pods --show-labels \nNAME        READY   STATUS    RESTARTS   AGE   LABELS\nnginx-pod   1/1     Running   0          54s   app=nginx\n\n#to access a pod\nabdelrahman@debian:~/k8s-series$ kubectl exec -it nginx-pod -- bash\n\n#to access log of container inside a pod\nabdelrahman@debian:~/k8s-series$ kubectl logs nginx-pod\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#create a pod with ngniz image\nabdelrahman@debian:~/k8s-series$ kubectl run ngnix-pod --image=nginx\npod/ngnix-pod created\n\n#list all the pods in the cluster\nabdelrahman@debian:~/k8s-series$ kubectl get pods\nNAME        READY   STATUS              RESTARTS   AGE\nngnix-pod   1/1     ContainerCreating   0          14s\n\n# -o wide option to know on which worker node does the pod live \nabdelrahman@debian:~/k8s-series$ kubectl get pods -o wide\nNAME        READY   STATUS    RESTARTS   AGE     IP                       NODE                    NOMINATED NODE   READINESS GATES\nngnix-pod   1/1         Running          0          3m15s   10.244.1.2   multi-node-cluster-worker               <none>           <none>\n\n#print a detailed snapshot of your Pod's current configurations, status metrics, and lifecycle events.\nabdelrahman@debian:~/k8s-series$ kubectl describe pod ngnix-pod\n\n#delete pod\nabdelrahman@debian:~/k8s-series$ kubectl delete pod ngnix-pod\n\n#creating pod using configuration file (ngnix-pod.yaml)\nabdelrahman@debian:~/k8s-series$ kubectl apply -f ngnix-pod.yaml\n\n# --show-labels display(labels) attached to the pods\nabdelrahman@debian:~/k8s-series$ kubectl get pods --show-labels \nNAME        READY   STATUS    RESTARTS   AGE   LABELS\nnginx-pod   1/1     Running   0          54s   app=nginx\n\n#to access a pod\nabdelrahman@debian:~/k8s-series$ kubectl exec -it nginx-pod -- bash\n\n#to access log of container inside a pod\nabdelrahman@debian:~/k8s-series$ kubectl logs nginx-pod\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BzNoq0kDKcSMgm17Hk_eS",
